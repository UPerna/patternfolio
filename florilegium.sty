%% florilegium.sty -- procedural botanical ornament (MIT)
%% Original: https://github.com/kevinraymond/florilegium
\NeedsTeXFormat{LaTeX2e}[2021/06/01]
\ProvidesPackage{florilegium}[2026/10/31 v1.4 botanical books and portable rendering]
\RequirePackage{iftex}
\ifLuaTeX\else\ifXeTeX\else
  \PackageError{florilegium}{Use LuaLaTeX or XeLaTeX}{pdfLaTeX cannot run this renderer.}\fi\fi
\RequirePackage{tikz}
\RequirePackage{eso-pic}
\RequirePackage{graphicx}
\newif\ifflorilegium@grown
\newif\ifflorilegium@margin \florilegium@margintrue
\newif\ifflorilegium@visitors \florilegium@visitorstrue
\newif\ifflorilegium@sections
\newif\ifflorilegium@aging
\newif\ifflorilegium@layoutset
\newcount\flo@initialok
\newif\ifflo@validrect
\def\flo@fallback{plain}
\def\flo@ifont{lmroman10-bold.otf}
\def\flo@settings{}
\ifLuaTeX
  \directlua{florilegium = require("florilegium")}
  \newcommand\flo@configure[2]{\directlua{florilegium.configure("#1", "\luaescapestring{#2}")}}
\else
  \newcommand\flo@configure[2]{\begingroup\edef\flo@next{\endgroup
    \noexpand\g@addto@macro\noexpand\flo@settings{{[==[#1]==],[==[#2]==]},}}\flo@next}
\fi
\newcommand\flo@grownonly{\PackageError{florilegium}{Layout controls require the grown option}{Add the package option grown.}}
\newcommand\flo@setlayout[2]{\florilegium@layoutsettrue\flo@configure{#1}{#2}}
\newcommand\flo@fallbackset[1]{\gdef\flo@fallback{#1}%
  \ifLuaTeX\directlua{florilegium.initial_fallback="#1"}\fi}
\newcommand\flo@options[1]{\pgfkeys{/florilegium/.cd,#1}}
\pgfkeys{/florilegium/.is family,/florilegium,
  density/.code={\flo@setlayout{density}{#1}},
  side/.code={\flo@setlayout{side}{#1}},
  style/.code={\flo@setlayout{style}{#1}},
  focal-count/.code={\flo@setlayout{focal_count}{#1}},
  focal-scale/.code={\flo@setlayout{focal_scale}{#1}},
  asymmetry/.code={\flo@setlayout{asymmetry}{#1}},
  pagenumber/.code={\flo@setlayout{page_number}{#1}},pagenumber/.default=true,
  number-scale/.code={\flo@setlayout{number_scale}{#1}},
  variation/.code={\flo@setlayout{variation}{#1}},
  seed/.code={\flo@setlayout{seed}{#1}},
  color-mode/.code={\flo@configure{color_mode}{#1}},
  text-gap/.code={\florilegium@layoutsettrue\ifLuaTeX
    \directlua{florilegium.configure("text_gap",\number\dimexpr#1\relax*2.54/(72.27*65536))}%
    \else\edef\flo@gap{\number\dimexpr#1\relax}\flo@configure{text_gap_sp}{\flo@gap}\fi},
  spill/.code={\flo@setlayout{spill}{#1}},spill/.default=true,
  footer/.code={\flo@setlayout{footer}{#1}},footer/.default=true,
  header/.code={\flo@setlayout{header}{#1}},header/.default=true,
  initial-fallback/.is choice,
  initial-fallback/plain/.code={\flo@fallbackset{plain}},
  initial-fallback/error/.code={\flo@fallbackset{error}}}
\DeclareOption{authored}{\florilegium@grownfalse}
\DeclareOption{grown}{\florilegium@growntrue}
\DeclareOption{nomargin}{\florilegium@marginfalse}
\DeclareOption{novisitors}{\florilegium@visitorsfalse}
\DeclareOption{sections}{\florilegium@sectionstrue}
\DeclareOption{aging}{\florilegium@agingtrue}
\DeclareOption*{\expandafter\flo@options\expandafter{\CurrentOption}}
\ProcessOptions\relax
\ifflorilegium@layoutset\ifflorilegium@grown\else\flo@grownonly\fi\fi
\newcommand\florilegiumsetup[1]{\ifflorilegium@grown\flo@options{#1}\else\flo@grownonly\fi}
\ifdefined\florilegiumseed\else\def\florilegiumseed{}\fi
\definecolor{ink}{HTML}{2456C4}
\definecolor{accent}{HTML}{B4662F}
\def\florilegium@colors{%
  \extractcolorspecs{ink}{\flo@m}{\flo@s}\convertcolorspec{\flo@m}{\flo@s}{rgb}\flo@ink
  \extractcolorspecs{accent}{\flo@m}{\flo@s}\convertcolorspec{\flo@m}{\flo@s}{rgb}\flo@acc
  \flo@applycolors}
\def\flo@endpage{-1}\def\flo@endtotal{0pt}
\ifLuaTeX\input{florilegium-luatex.def}\else\input{florilegium-xetex.def}\fi
\newcommand\florilegiumtextend{\par\xdef\flo@endpage{\number\value{page}}%
  \xdef\flo@endtotal{\the\dimexpr\pagetotal+\pagedepth\relax}}
\newcommand\florilegiumbloom[1][]{\flo@bloom{#1}}
\protected\def\florilegium@headmark#1{\ifnum#1<3 \flo@headingmark{#1}\fi}
\NewDocumentCommand\florilegiumreserve{O{3mm} m m m m}{%
  \ifflorilegium@grown\begingroup\flo@validrecttrue
    \ifdim\dimexpr#4\relax>0pt\relax\else\flo@validrectfalse
      \PackageError{florilegium}{reserve width/height must be positive}{Use a positive width.}\fi
    \ifdim\dimexpr#5\relax>0pt\relax\else\flo@validrectfalse
      \PackageError{florilegium}{reserve width/height must be positive}{Use a positive height.}\fi
    \ifdim\dimexpr#1\relax<0pt\relax\flo@validrectfalse
      \PackageError{florilegium}{reserve padding must be nonnegative}{Use zero or positive padding.}\fi
    \ifflo@validrect\flo@reservepage{\number\dimexpr#2\relax}{\number\dimexpr#3\relax}%
      {\number\dimexpr#4\relax}{\number\dimexpr#5\relax}{\number\dimexpr#1\relax}\fi\endgroup
  \else\flo@grownonly\fi}
\NewDocumentEnvironment{florilegiumprotect}{O{3mm} +b}{\par\begingroup
  \ifflorilegium@grown\else\flo@grownonly\fi
  \flo@validrecttrue
  \ifdim\dimexpr#1\relax<0pt\relax\flo@validrectfalse
    \PackageError{florilegium}{reserve padding must be nonnegative}{Use zero or positive padding.}\fi
  \setbox\@tempboxa=\vbox{\hsize=\linewidth #2\par}%
  \noindent\ifflo@validrect\flo@reservebox{\number\wd\@tempboxa}{\number\ht\@tempboxa}%
    {\number\dp\@tempboxa}{\number\dimexpr#1\relax}\fi\box\@tempboxa\par\endgroup}{}

\ifflorilegium@sections
  % Wrap the public title argument after class/heading packages have installed
  % their commands. Explicit short titles keep markers out of TOCs and bookmarks.
  \newcommand\flo@heading[5]{\IfBooleanTF{#3}{#1*{#5}}{%
    \IfNoValueTF{#4}{#1[{#5}]{\florilegium@headmark{#2}#5}}{#1[{#4}]{\florilegium@headmark{#2}#5}}}}
  \AddToHook{begindocument/end}{%
    \let\flo@section\section \let\flo@subsection\subsection
    \RenewDocumentCommand\section{s o m}{\flo@heading\flo@section{1}{#1}{#2}{#3}}%
    \RenewDocumentCommand\subsection{s o m}{\flo@heading\flo@subsection{2}{#1}{#2}{#3}}%
    \ifdefined\chapter\let\flo@chapter\chapter
      \RenewDocumentCommand\chapter{s o m}{\flo@heading\flo@chapter{0}{#1}{#2}{#3}}\fi}
\fi
\newcommand\florilegiuminitial[2][4]{\par
  \begingroup
    \dimen@=\fontcharht\font`\H
    \global\dimen1=\dimexpr\baselineskip*\numexpr#1-1\relax+\dimen@\relax
    \global\dimen3=\dimen@
  \endgroup
  \hangindent=\dimexpr\dimen1+0.6em\relax \hangafter=-#1\relax
  \noindent\florilegium@colors
  \flo@initialdraw{#2}{\number\dimen1}{\number\hangindent}{\number\dimen3}%
  \ifnum\flo@initialok=1
    \llap{\flo@hidden{true}#2\flo@hidden{false}}%
  \else\ifnum\flo@initialok=0
    \llap{\flo@empty{true}%
      \raisebox{\dimexpr\dimen3-\dimen1\relax}[0pt][0pt]{%
        \makebox[\hangindent][l]{\resizebox{!}{\dimen1}{\bfseries #2}}}%
      \flo@empty{false}}%
    \llap{\flo@hidden{true}#2\flo@hidden{false}}%
  \fi\fi
  \ignorespaces}

\newcommand\florilegiuminitialfont[1]{\gdef\flo@ifont{#1}\flo@setinitialfont{#1}}
%% Named external vector PDFs are embedded once by graphicx and reused as Forms.
\newcommand\florilegiumdeclareasset[2]{%
  \IfFileExists{#2}{\expandafter\gdef\csname flo@asset@#1\endcsname{#2}}{%
    \PackageError{florilegium}{Asset file not found: #2}{Export it with tools/exportasset.py first.}}}
\newcommand\florilegiumuseasset[2][]{%
  \ifcsname flo@asset@#2\endcsname
    \includegraphics[#1]{\csname flo@asset@#2\endcsname}%
  \else\PackageError{florilegium}{Unknown asset: #2}{Declare the asset before using it.}\fi}\NewDocumentCommand\florilegiumdivider{O{36mm}}{\par\addvspace{0.7\baselineskip}%
  \noindent\makebox[\linewidth][c]{\resizebox{#1}{!}{\begin{tikzpicture}%
    \path[use as bounding box](-2.05,-0.42) rectangle (2.05,0.42);%
    \florilegiumdraw{divider}{1}\end{tikzpicture}}}\par\addvspace{0.7\baselineskip}}


\ifflorilegium@aging
  \AtEndDocument{\immediate\write\@auxout{\gdef\string\flo@lastpage{\number\value{page}}}%
    \ifdefined\flo@lastpage\ifnum\flo@lastpage=\value{page}\else\flo@rerun\fi\else\flo@rerun\fi}
  \def\flo@rerun{\PackageWarningNoLine{florilegium}{The page count changed. Rerun to get the aging right}}
\fi
%% Use physical coordinates even when the text's origin is offset.
\newcommand\flo@pageorigin[1]{\AtPageLowerLeft{\put(-\hoffset,\voffset){#1}}}
\ifflorilegium@margin
  \ifflorilegium@grown\AddToShipoutPictureBG{\flo@pageorigin{\margingardengrown}}%
  \else\AddToShipoutPictureBG{\flo@pageorigin{\margingarden}}\fi
\fi
\input{florilegium-patterns.def}
\endinput
