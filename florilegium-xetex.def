%% XeTeX host, adapted from wilsybubs/florilegium 6f1d846 (MIT).
%% Records are drawn by texlua between TeX passes. No shell escape is required.
\newwrite\flo@out
\newcount\flo@item
\newcount\flo@shipped
\newcount\flo@rngk
\newdimen\flo@D \flo@D=1200bp
\newbox\flo@box
\def\flo@rngpage{nil}\def\flo@rngfixed{nil}\def\flo@rngsettings{}
\def\flo@frame{nil}\def\flo@age{nil}
\def\flo@drawncount{0}\def\flo@drawnmd5{}
\def\flo@drawn#1#2{\def\flo@drawncount{#1}\def\flo@drawnmd5{#2}}
\def\flo@initialstatus#1#2{\expandafter\gdef\csname flo@status@#1\endcsname{#2}}
\AtBeginDocument{%
  \ifdefined\flo@externalstale\else\InputIfFileExists{\jobname-flo.tex}{}{}\fi%
  \immediate\openout\flo@out=\jobname.flo\relax}
\def\flo@applycolors{}
\def\flo@colrec{ink={\flo@ink},accent={\flo@acc}}
\def\flo@rngrec{rng={page=\flo@rngpage,fixed=\flo@rngfixed,k=\the\flo@rngk,settings={\flo@rngsettings}}}
\def\flo@configrec{settings={\flo@settings},fallback=[==[\flo@fallback]==]}
\def\flo@image{%
  \ifnum\flo@item>\flo@drawncount\relax\else
    \special{pdf:image page \the\flo@item\space (\jobname-flo.pdf)}%
  \fi}
\def\flo@inline{%
  \setbox\flo@box\hbox to\z@{\kern-\flo@D\lower\flo@D\hbox to\z@{\flo@image\hss}\hss}%
  \ht\flo@box\z@\dp\flo@box\z@\box\flo@box}
\newcommand\florilegiumdraw[2]{%
  \florilegium@colors\global\advance\flo@item\@ne
  \edef\flo@args{#2}%
  \immediate\write\flo@out{DRAW{id=\the\flo@item,name=[==[#1]==],args=[==[\detokenize\expandafter{\flo@args}]==],
    aa=[==[\pgf@pt@aa]==],ab=[==[\pgf@pt@ab]==],ba=[==[\pgf@pt@ba]==],bb=[==[\pgf@pt@bb]==],
    x=\number\pgf@pt@x,y=\number\pgf@pt@y,\flo@colrec,\flo@rngrec,\flo@configrec}}%
  \global\advance\flo@rngk\@ne\flo@inline}
\newcommand\flo@initialdraw[4]{%
  \global\advance\flo@item\@ne
  \immediate\write\flo@out{INITIAL{id=\the\flo@item,letter=[==[#1]==],side=#2,hang=#3,cap=#4,
    font=[==[\flo@ifont]==],\flo@colrec,\flo@rngrec,\flo@configrec}}%
  \global\advance\flo@rngk\@ne
  \flo@initialok=0\relax
  \ifcsname flo@status@\the\flo@item\endcsname
    \flo@initialok=\csname flo@status@\the\flo@item\endcsname\relax\fi
  \flo@inline}
\newcommand\flo@setinitialfont[1]{}
\newcommand\flo@hidden[1]{\csname flo@hidden@#1\endcsname}
\def\flo@hidden@true{\special{pdf:literal direct 3 Tr}}
\def\flo@hidden@false{\special{pdf:literal direct 0 Tr}}
\newcommand\flo@empty[1]{\csname flo@empty@#1\endcsname}
\def\flo@empty@true{\special{pdf:literal direct /Span << /ActualText <FEFF> >> BDC}}
\def\flo@empty@false{\special{pdf:literal direct EMC}}
\newcommand\florilegiumage[1]{\xdef\flo@age{#1}}
\newcommand\florilegiumframe[3][]{\xdef\flo@frame{{k=#2,n=#3,explain=[==[#1]==]}}}
\def\flo@page{%
  \global\advance\flo@item\@ne\global\advance\flo@shipped\@ne
  \florilegium@colors
  \xdef\flo@rngpage{\number\value{page}}%
  \xdef\flo@rngfixed{\ifx\florilegiumseed\@empty nil\else\florilegiumseed\fi}%
  \global\let\flo@rngsettings\flo@settings
  \edef\flo@rec{PAGE{id=\the\flo@item,n=\the\flo@shipped,page=\number\value{page},label=[==[\thepage]==],
    fixed=\flo@rngfixed,grown=\ifflorilegium@grown true\else false\fi,
    twoside=\if@twoside true\else false\fi,visitors=\ifflorilegium@visitors true\else false\fi,
    aging=\ifflorilegium@aging true\else false\fi,age=\flo@age,
    last=\ifdefined\flo@lastpage\flo@lastpage\else nil\fi,\flo@colrec,\flo@configrec,
    endpage=\flo@endpage,endtotal=\number\dimexpr\flo@endtotal\relax,frame=\flo@frame,
    paperwidth=\number\paperwidth,paperheight=\number\paperheight,
    hoffset=\number\hoffset,voffset=\number\voffset,
    oddsidemargin=\number\oddsidemargin,evensidemargin=\number\evensidemargin,textwidth=\number\textwidth,
    topmargin=\number\topmargin,headheight=\number\headheight,headsep=\number\headsep,
    textheight=\number\textheight,footskip=\number\footskip}}%
  \edef\flo@next{\noexpand\write\flo@out{\flo@rec}}\flo@next
  \flo@image
  % Only the header consumes the page RNG; settings are resolved by the driver.
  \global\flo@rngk=0\relax}
\newcommand\margingarden{\flo@page}
\newcommand\margingardengrown{\flo@page}
\ifflorilegium@margin
\def\flo@mark#1#2{\begingroup\edef\flo@arg{#2}%
  \edef\flo@next{\endgroup\noexpand\flo@markfrozen{#1}{\flo@arg}}\flo@next}
\def\flo@markfrozen#1#2{\pdfsavepos
  \write\flo@out{MARK{n=\the\flo@shipped,kind="#1",arg=#2,x=\the\pdflastxpos,y=\the\pdflastypos}}}
\else\let\flo@mark\@gobbletwo\fi
\newcommand\flo@bloom[1]{\flo@mark{bloom}{[==[#1]==]}}
\newcommand\flo@headingmark[1]{\flo@mark{heading}{#1}}
\newcommand\flo@reservepage[5]{\flo@mark{reserve_page}{{x=#1,y=#2,w=#3,h=#4,pad=#5}}}
\newcommand\flo@reservebox[4]{\flo@mark{reserve_box}{{w=#1,h=#2,d=#3,pad=#4}}}
\AddToHook{enddocument/afterlastpage}{%
  \immediate\write\flo@out{CONFIG{settings={\flo@settings}}}%
  \immediate\closeout\flo@out
  \edef\flo@md5{\mdfivesum file{\jobname.flo}}%
  \ifnum\strcmp{\flo@md5}{\flo@drawnmd5}=\z@\else
    \PackageWarningNoLine{florilegium}{Drawings are missing or out of date. Use tools/build.py --engine xe,
      or run texlua florilegium-xe.lua \jobname\space and then XeLaTeX again}%
  \fi}
\endinput
